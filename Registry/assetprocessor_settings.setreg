{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder AtomRml/Assets": {
                    "watch": "@GEMROOT:AtomRml/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder AtomRml/Registry": {
                    "watch": "@GEMROOT:AtomRml/Registry",
                    "recursive": 1,
                    "order": 102
                },
                "RC rml": {
					"glob": "*.rml",
					"params": "copy",
					"productAssetType": "{028B1060-B8EC-4116-BBD6-F3B7E7257E65}"
                },
                "RC rcss": {
					"glob": "*.rcss",
					"params": "copy",
					"productAssetType": "{028B1060-B8EC-4116-BBD6-F3B7E7257E65}"
                }
            }
        }
    }
}
