{
    "Type": "JsonSerialization",
    "Version": 1,
    "ClassName": "PassAsset",
    "ClassData": {
        "PassTemplate": {
            "Name": "AtomRmlChildPassDirectTemplate",
            "PassClass": "AtomRmlChildPass",
            "Slots": [
                {
                    "Name": "ColorInputOutput",
                    "SlotType": "InputOutput",
                    "ScopeAttachmentUsage": "RenderTarget",
                    "LoadStoreAction": {
                        "LoadAction": "Load",
                        "StoreAction": "Store"
                    }
                },
                {
                    "Name": "DepthInputOutput",
                    "SlotType": "InputOutput", 
                    "ScopeAttachmentUsage": "DepthStencil",
                    "LoadStoreAction": {
                        "ClearValue": {
                            "Type": "DepthStencil"
                        },
                        "LoadAction": "None",
                        "LoadActionStencil": "Clear",
                        "StoreAction": "None",
                        "StoreActionStencil": "DontCare"
                    }
                }
            ],
            "ImageAttachments": [
                {
                    "Name": "DepthStencilImageMSAA",
                    "ImageDescriptor": {
                        "Format": "D32_FLOAT_S8X24_UINT",
                        "SharedQueueMask": "Graphics",
                        "MultisampleState": {
                            "samples": 4
                        }
                    },
                    "SizeSource": {
                        "Source": {
                            "Pass": "This",
                            "Attachment": "ColorInputOutput"
                        }
                    }
                }
            ],
            "Connections": [
                {
                    "LocalSlot": "ColorInputOutput",
                    "AttachmentRef": {
                        "Pass": "Parent",
                        "Attachment": "ColorImageMSAA"
                    }
                },
                {
                    "LocalSlot": "DepthInputOutput",
                    "AttachmentRef": {
                        "Pass": "This",
                        "Attachment": "DepthStencilImageMSAA"
                    }
                }
            ],
            "PassData": {
                "$type": "RasterPassData",
                "DrawListTag": "atomrml",
                "BindViewSrg": true
            }
        }
    }
}
