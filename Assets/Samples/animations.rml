<rml>
<head>
    <title>AtomRml animation sample</title>
    <style>
        body {
            display: block;
            width: 100%;
            height: 100%;
            margin: 0;
            font-family: "Bitstream Vera Sans";
            font-size: 16dp;
            color: #e7edf7;
            background-color: #0d111bcc;
        }

        #panel {
            display: block;
            position: absolute;
            left: 50%;
            top: 50%;
            width: 680dp;
            margin-left: -366dp;
            margin-top: -242dp;
            padding: 26dp;
            background-color: #171e2bed;
            border: 2dp #35445c;
            border-radius: 12dp;
        }

        h1 {
            display: block;
            margin: 0 0 8dp 0;
            font-size: 30dp;
            color: #79c8ff;
        }

        p {
            display: block;
            margin: 0;
        }

        .hint {
            margin-bottom: 24dp;
            color: #aebbd0;
        }

        .section-title {
            display: block;
            margin: 18dp 0 9dp 0;
            color: #d9e3f3;
            font-size: 18dp;
        }

        #track {
            display: block;
            height: 72dp;
            padding: 8dp;
            overflow: hidden;
            background-color: #101722;
            border: 2dp #29384d;
            border-radius: 9dp;
        }

        #runner {
            display: block;
            width: 56dp;
            height: 56dp;
            line-height: 56dp;
            text-align: center;
            color: #07131e;
            background-color: #79c8ff;
            border-radius: 10dp;
            transform: translateX(0dp) rotate(0deg);
            animation: 2.4s cubic-in-out infinite alternate travel;
        }

        @keyframes travel {
            from {
                transform: translateX(0dp) rotate(0deg);
                background-color: #79c8ff;
            }
            to {
                transform: translateX(592dp) rotate(360deg);
                background-color: #f4cf66;
            }
        }

        #status-row {
            display: block;
            margin-top: 18dp;
            padding: 13dp 15dp;
            color: #aebbd0;
            background-color: #101722;
            border-left: 3dp #58d68d;
        }

        #pulse {
            display: inline-block;
            width: 13dp;
            height: 13dp;
            margin-right: 10dp;
            vertical-align: middle;
            background-color: #58d68d;
            border-radius: 7dp;
            animation: 0.85s cubic-in-out infinite alternate pulse;
        }

        @keyframes pulse {
            from {
                opacity: 0.35;
                transform: scale(0.75);
            }
            to {
                opacity: 1;
                transform: scale(1.25);
            }
        }

        #hover-card {
            display: block;
            margin-top: 18dp;
            padding: 15dp 18dp;
            color: #9bdcff;
            background-color: #223047;
            border: 2dp #4b657f;
            border-radius: 8dp;
            cursor: pointer;
            transform: translateX(0dp) scale(1);
            transition: all 0.35s cubic-out;
        }

        #hover-card:hover {
            color: white;
            background-color: #147eb3;
            border-color: #a7e8ff;
            transform: translateX(12dp) scale(1.03);
        }

        .label {
            color: #f4cf66;
        }
    </style>
</head>
<body>
    <div id="panel">
        <h1>Animation sample</h1>
        <p class="hint">Keyframes and transitions rendered by AtomRml.</p>

        <div class="section-title">Continuous keyframe animation</div>
        <div id="track">
            <div id="runner">Rml</div>
        </div>

        <div id="status-row">
            <span id="pulse"></span><span class="label">LIVE</span> — opacity and scale animation
        </div>

        <div class="section-title">Pointer transition</div>
        <div id="hover-card">Move the pointer here: color, border and transform should ease smoothly.</div>
    </div>
</body>
</rml>
